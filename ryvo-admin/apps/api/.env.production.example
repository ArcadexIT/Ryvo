# Copy to apps/api/.env.production on the server and fill in real values.
# Loaded by docker-compose.prod.yml via env_file for the api container.

DATABASE_URL="postgresql://ryvo:change-me-to-a-strong-password@postgres:5432/ryvo?schema=public"
REDIS_URL="redis://redis:6379"

JWT_ACCESS_SECRET="generate-a-long-random-string"
JWT_REFRESH_SECRET="generate-a-different-long-random-string"

PORT=4000
NODE_ENV="production"
# Origin of the public site that hosts /track/<token>. No trailing slash.
PUBLIC_WEB_URL="https://ryvo.arcadexit.com"
CORS_ORIGINS="https://ryvo.arcadexit.com,https://ryvo.arcadexit.com"

AWS_S3_BUCKET="ryvo-uploads"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
# AWS keys above stay for SES email and for opening files already stored on S3.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

EMAIL_FROM="noreply@ryvo.arcadexit.com"

STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

GOOGLE_APPLICATION_CREDENTIALS="./firebase-service-account.json"
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Twilio SMS OTP — https://console.twilio.com
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
# Use a Twilio phone number OR a Messaging Service SID (recommended for production)
# TWILIO_PHONE_NUMBER="+1..."
TWILIO_MESSAGING_SERVICE_SID="MG..."
