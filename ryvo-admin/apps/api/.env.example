DATABASE_URL="postgresql://ryvo:ryvo_secret@localhost:5433/ryvo?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="ryvo-dev-access-secret-change-in-production"
JWT_REFRESH_SECRET="ryvo-dev-refresh-secret-change-in-production"
PORT=4000
CORS_ORIGINS="http://localhost:3000"
AWS_S3_BUCKET="ryvo-uploads"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="local"
AWS_SECRET_ACCESS_KEY="local"
# New uploads. Old amazonaws.com links still use the AWS keys above.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
# Optional custom CDN/domain for stored file URLs (see docs/AWS_S3_SETUP.md)
# AWS_S3_PUBLIC_BASE_URL="https://cdn.example.com"
# Transactional email (AWS SES) — verify sender in SES console
EMAIL_FROM="noreply@yourdomain.com"
STRIPE_SECRET_KEY=""
# Stripe test secret key (sk_test_...) — must match the publishable key in Admin → Settings → Billing
# STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET=""
# FCM push — recommended: download Firebase service account JSON and save as:
#   apps/api/firebase-service-account.json
# Then set (path is relative to apps/api when running the API):
GOOGLE_APPLICATION_CREDENTIALS="./firebase-service-account.json"
# Alternative: single-line JSON only (do NOT paste multiline JSON — dotenv will break it)
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Twilio SMS OTP — https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Production: prefer Messaging Service SID; leave TWILIO_PHONE_NUMBER empty
TWILIO_PHONE_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
# Dev alternative: set TWILIO_PHONE_NUMBER="+1..." and leave MESSAGING_SERVICE_SID empty
# WhatsApp booking (same Twilio account). Use the sandbox or approved from-number.
TWILIO_WHATSAPP_FROM=""
# Optional LLM for WhatsApp NLU. Leave empty to use the built-in keyword state machine.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
NODE_ENV="development"
