generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  customer
  provider
  admin
}

enum UserStatus {
  active
  suspended
  pending_verification
  deleted
}

enum AdminRole {
  super_admin
  ops
  finance
  support
}

enum VerificationStatus {
  pending
  approved
  rejected
  suspended
}

enum OnlineStatus {
  offline
  online
  busy
}

enum JobStatus {
  draft
  searching
  matched
  provider_en_route
  arrived
  in_progress
  completed
  cancelled_by_customer
  cancelled_by_provider
  cancelled_by_admin
  no_provider_found
  payment_pending
}

enum BookingType {
  instant
  scheduled
}

enum PaymentMethod {
  stripe
  wallet
  cash
}

enum PaymentStatus {
  pending
  held
  paid
  failed
  refunded
}

enum WalletTransactionType {
  top_up
  job_hold
  job_payment
  refund
  admin_adjustment
  payout
}

enum DocumentType {
  license // driver license front
  insurance
  vehicle_registration
  id_card // driver license back (reused; avoids a schema migration)
  selfie // identity selfie for manual match vs license
  equipment_proof // proof of service equipment
}

enum DocumentReviewStatus {
  pending
  approved
  rejected
}

enum JobOfferStatus {
  sent
  accepted
  rejected
  expired
}

enum PayoutStatus {
  pending
  processing
  paid
  rejected
}

enum ZoneAudience {
  customer
  provider
  both
}

enum QualificationStatus {
  not_started
  training
  equipment_review
  approved
}

enum TrainingBlockType {
  text
  image
  video
}

enum AgreementKey {
  service
  tax_status
  insurance
}

enum InsuranceProofStatus {
  not_requested
  requested
  submitted
  approved
  rejected
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

enum SupportPriority {
  low
  medium
  high
  urgent
}

enum NotificationChannel {
  push
  sms
  email
  in_app
}

enum CancelledBy {
  customer
  provider
  admin
  system
}

enum DiscountType {
  percentage
  fixed
}

enum JobType {
  taxi
  bidding
  parcel
}

enum ParcelSize {
  small
  medium
  large
}

enum JobBidKind {
  accept
  counter
}

enum JobBidStatus {
  pending
  accepted
  rejected
  expired
  withdrawn
}

enum ServiceBusinessType {
  taxi
  parcel
}

enum SubscriptionPeriod {
  daily
  weekly
  monthly
}

enum DriverSubscriptionStatus {
  pending
  active
  expired
  cancelled
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid())
  phone           String     @unique
  email           String?    @unique
  passwordHash    String?    @map("password_hash")
  fullName        String     @map("full_name")
  avatarUrl       String?    @map("avatar_url")
  role            UserRole
  status          UserStatus @default(active)
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  fcmToken        String?    @map("fcm_token")
  fcmTokenIos     String?    @map("fcm_token_ios")
  fcmTokenAndroid String?    @map("fcm_token_android")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  customer         Customer?
  provider         Provider?
  adminUser        AdminUser?
  refreshTokens    RefreshToken[]
  wallet           Wallet?
  notifications    Notification[]
  ratingsGiven     Rating[]       @relation("RatingsGiven")
  ratingsReceived  Rating[]       @relation("RatingsReceived")
  supportTickets   SupportTicket[]
  supportMessages  SupportMessage[]
  coverageInterests CoverageInterest[]

  @@map("users")
}

model AdminUser {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  adminRole   AdminRole @map("admin_role")
  permissions Json      @default("[]")
  totpSecret  String?   @map("totp_secret")
  totpEnabled Boolean   @default(false) @map("totp_enabled")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedDocuments ProviderDocument[] @relation("DocumentReviewer")
  assignedTickets   SupportTicket[]    @relation("TicketAssignee")
  auditLogs         AuditLog[]

  @@map("admin_users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpVerification {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("otp_verifications")
}

// ─── Customer ────────────────────────────────────────────────────────────────

model Customer {
  id                    String        @id @default(uuid())
  userId                String        @unique @map("user_id")
  defaultPaymentMethod  PaymentMethod? @map("default_payment_method")
  stripeCustomerId      String?       @unique @map("stripe_customer_id")
  ratingAvg             Decimal       @default(0) @map("rating_avg") @db.Decimal(3, 2)
  totalJobs             Int           @default(0) @map("total_jobs")
  termsAcceptedAt       DateTime?     @map("terms_accepted_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  vehicles  Vehicle[]
  jobs      Job[]
  invoices  Invoice[]

  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  label       String?
  addressLine String   @map("address_line")
  lat         Decimal  @db.Decimal(10, 7)
  lng         Decimal  @db.Decimal(10, 7)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Vehicle {
  id           String  @id @default(uuid())
  customerId   String  @map("customer_id")
  vehicleType  String  @default("car") @map("vehicle_type") // car | motorcycle
  make         String
  model        String
  year         Int
  plateNumber  String  @map("plate_number")
  transmission String? // manual | auto
  fuelType     String? @map("fuel_type") // petrol | diesel | electric
  color        String?
  engineCapacity String? @map("engine_capacity")
  photoUrl     String? @map("photo_url")
  isDefault    Boolean @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs     Job[]

  @@map("vehicles")
}

// ─── Provider ────────────────────────────────────────────────────────────────

model Provider {
  id                       String             @id @default(uuid())
  userId                   String             @unique @map("user_id")
  businessName             String?            @map("business_name")
  verificationStatus       VerificationStatus @default(pending) @map("verification_status")
  onlineStatus             OnlineStatus       @default(offline) @map("online_status")
  currentLat               Decimal?           @map("current_lat") @db.Decimal(10, 7)
  currentLng               Decimal?           @map("current_lng") @db.Decimal(10, 7)
  lastLocationAt           DateTime?          @map("last_location_at")
  ratingAvg                Decimal            @default(0) @map("rating_avg") @db.Decimal(3, 2)
  totalJobs                Int                @default(0) @map("total_jobs")
  commissionRate           Decimal?           @map("commission_rate") @db.Decimal(5, 4)
  bankAccountRef           String?            @map("bank_account_ref")
  agreementAcceptedAt      DateTime?          @map("agreement_accepted_at")
  agreementVersionAccepted String?            @map("agreement_version_accepted")
  stripeAccountId          String?            @unique @map("stripe_account_id")
  insuranceProofStatus     InsuranceProofStatus @default(not_requested) @map("insurance_proof_status")
  insuranceProofRequestedAt DateTime?         @map("insurance_proof_requested_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    ProviderDocument[]
  vehicles     ProviderVehicle[]
  availability ProviderAvailability[]
  serviceAreas ProviderServiceArea[]
  jobs         Job[]
  jobOffers    JobOffer[]
  earnings     ProviderEarning[]
  payouts      Payout[]
  bankAccounts BankAccount[]
  locationLogs JobLocationLog[]
  trainingAttempts ProviderTrainingAttempt[]
  qualifications   ProviderQualification[]
  agreementAcceptances ProviderAgreementAcceptance[]
  jobBids          JobBid[]
  subscriptions    DriverSubscription[]

  @@map("providers")
}

model ProviderDocument {
  id              String               @id @default(uuid())
  providerId      String               @map("provider_id")
  docType         DocumentType         @map("doc_type")
  fileUrl         String               @map("file_url")
  status          DocumentReviewStatus @default(pending)
  reviewedById    String?              @map("reviewed_by_id")
  reviewedAt      DateTime?            @map("reviewed_at")
  rejectionReason String?              @map("rejection_reason")
  serviceCategoryId String?            @map("service_category_id")
  equipmentRequirementId String?       @map("equipment_requirement_id")
  equipmentLabel  String?              @map("equipment_label")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  equipmentRequirement EquipmentRequirement? @relation(fields: [equipmentRequirementId], references: [id])

  @@map("provider_documents")
}

model ProviderVehicle {
  id                  String   @id @default(uuid())
  providerId          String   @map("provider_id")
  vehicleType         String   @default("car") @map("vehicle_type") // car | motorcycle
  make                String
  model               String
  year                Int
  plateNumber         String   @map("plate_number")
  transmission        String? // manual | auto
  fuelType            String?  @map("fuel_type") // petrol | diesel | electric
  color               String?
  engineCapacity      String?  @map("engine_capacity")
  serviceCapabilities Json     @default("[]") @map("service_capabilities")
  photoUrl            String?  @map("photo_url")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_vehicles")
}

model ProviderAvailability {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  dayOfWeek  Int      @map("day_of_week")
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_availability")
}

model ProviderServiceArea {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  centerLat  Decimal  @map("center_lat") @db.Decimal(10, 7)
  centerLng  Decimal  @map("center_lng") @db.Decimal(10, 7)
  radiusKm   Decimal  @map("radius_km") @db.Decimal(6, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_service_areas")
}

// ─── Services & Pricing ──────────────────────────────────────────────────────

model ServiceCategory {
  id            String               @id @default(uuid())
  name          String
  slug          String               @unique
  icon          String?
  description   String?
  businessType  ServiceBusinessType  @default(taxi) @map("business_type")
  isActive      Boolean              @default(true) @map("is_active")
  sortOrder     Int                  @default(0) @map("sort_order")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  pricingRules ServicePricingRule[]
  jobs         Job[]
  trainingPrograms TrainingProgram[]
  equipmentRequirements EquipmentRequirement[]
  qualifications ProviderQualification[]
  documents ProviderDocument[]

  @@map("service_categories")
}

model ServicePricingRule {
  id                String    @id @default(uuid())
  serviceCategoryId String    @map("service_category_id")
  baseFare          Decimal   @map("base_fare") @db.Decimal(10, 2)
  perKmRate         Decimal   @default(0) @map("per_km_rate") @db.Decimal(10, 2)
  perMinuteRate     Decimal   @default(0) @map("per_minute_rate") @db.Decimal(10, 2)
  minFare           Decimal   @default(0) @map("min_fare") @db.Decimal(10, 2)
  surgeMultiplier   Decimal   @default(1) @map("surge_multiplier") @db.Decimal(4, 2)
  city              String?
  effectiveFrom     DateTime  @default(now()) @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@map("service_pricing_rules")
}

model PromoCode {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  maxUses       Int?         @map("max_uses")
  usedCount     Int          @default(0) @map("used_count")
  validFrom     DateTime     @map("valid_from")
  validTo       DateTime     @map("valid_to")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("promo_codes")
}

// ─── Jobs ────────────────────────────────────────────────────────────────────

model Job {
  id                String       @id @default(uuid())
  jobNumber         String       @unique @map("job_number")
  customerId        String       @map("customer_id")
  providerId        String?      @map("provider_id")
  vehicleId         String?      @map("vehicle_id")
  serviceCategoryId String       @map("service_category_id")
  status            JobStatus    @default(draft)
  jobType           JobType      @default(taxi) @map("job_type")
  bookingType       BookingType  @default(instant) @map("booking_type")
  scheduledAt       DateTime?    @map("scheduled_at")
  pickupAddress     String       @map("pickup_address")
  pickupLat         Decimal      @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng         Decimal      @map("pickup_lng") @db.Decimal(10, 7)
  excludedProviderIds String[]   @default([]) @map("excluded_provider_ids")
  dropoffAddress    String?      @map("dropoff_address")
  dropoffLat        Decimal?     @map("dropoff_lat") @db.Decimal(10, 7)
  dropoffLng        Decimal?     @map("dropoff_lng") @db.Decimal(10, 7)
  customerNotes     String?      @map("customer_notes")
  estimatedFare     Decimal?     @map("estimated_fare") @db.Decimal(10, 2)
  finalFare         Decimal?     @map("final_fare") @db.Decimal(10, 2)
  offeredPrice      Decimal?     @map("offered_price") @db.Decimal(10, 2)
  agreedFare        Decimal?     @map("agreed_fare") @db.Decimal(10, 2)
  recipientName     String?      @map("recipient_name")
  recipientPhone    String?      @map("recipient_phone")
  parcelSize        ParcelSize?  @map("parcel_size")
  parcelNotes       String?      @map("parcel_notes")
  pickupPhotoUrl    String?      @map("pickup_photo_url")
  dropoffPhotoUrl   String?      @map("dropoff_photo_url")
  recipientOtp      String?      @map("recipient_otp")
  channel           String       @default("app")
  distanceKm        Decimal?     @map("distance_km") @db.Decimal(8, 2)
  durationMin       Int?         @map("duration_min")
  promoCodeId       String?      @map("promo_code_id")
  matchedAt         DateTime?    @map("matched_at")
  arrivedAt         DateTime?    @map("arrived_at")
  providerStartConfirmedAt DateTime? @map("provider_start_confirmed_at")
  customerStartConfirmedAt DateTime? @map("customer_start_confirmed_at")
  startedAt         DateTime?    @map("started_at")
  completedAt       DateTime?    @map("completed_at")
  cancelledAt       DateTime?    @map("cancelled_at")
  cancellationReason String?     @map("cancellation_reason")
  cancelledBy       CancelledBy? @map("cancelled_by")
  cancellationFeeAmount Decimal? @map("cancellation_fee_amount") @db.Decimal(10, 2)
  providerPenaltyAmount Decimal? @map("provider_penalty_amount") @db.Decimal(10, 2)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  customer        Customer         @relation(fields: [customerId], references: [id])
  provider        Provider?        @relation(fields: [providerId], references: [id])
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])
  serviceCategory ServiceCategory  @relation(fields: [serviceCategoryId], references: [id])
  statusHistory   JobStatusHistory[]
  offers          JobOffer[]
  locationLogs    JobLocationLog[]
  messages        JobMessage[]
  payment         Payment?
  invoice         Invoice?
  ratings         Rating[]
  providerEarning ProviderEarning?
  supportTickets  SupportTicket[]
  bids            JobBid[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([providerId])
  @@index([jobType, status])
  @@map("jobs")
}

model JobBid {
  id         String       @id @default(uuid())
  jobId      String       @map("job_id")
  providerId String       @map("provider_id")
  amount     Decimal      @db.Decimal(10, 2)
  kind       JobBidKind
  status     JobBidStatus @default(pending)
  message    String?
  expiresAt  DateTime?    @map("expires_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id])

  @@unique([jobId, providerId])
  @@index([jobId, status])
  @@index([providerId])
  @@map("job_bids")
}

model JobMessage {
  id             String    @id @default(uuid())
  jobId          String    @map("job_id")
  senderId       String    @map("sender_id")
  senderType     String    @map("sender_type")
  text           String
  deliveryStatus String    @default("sent") @map("delivery_status")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_messages")
}

model JobStatusHistory {
  id            String     @id @default(uuid())
  jobId         String     @map("job_id")
  fromStatus    JobStatus? @map("from_status")
  toStatus      JobStatus  @map("to_status")
  changedByType String     @map("changed_by_type")
  changedById   String?    @map("changed_by_id")
  note          String?
  createdAt     DateTime   @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_status_history")
}

model JobOffer {
  id          String         @id @default(uuid())
  jobId       String         @map("job_id")
  providerId  String         @map("provider_id")
  status      JobOfferStatus @default(sent)
  offeredAt   DateTime       @default(now()) @map("offered_at")
  respondedAt DateTime?      @map("responded_at")
  expiresAt   DateTime       @map("expires_at")

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([jobId, providerId])
  @@map("job_offers")
}

model JobLocationLog {
  id         String   @id @default(uuid())
  jobId      String   @map("job_id")
  providerId String   @map("provider_id")
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  heading    Decimal? @db.Decimal(5, 2)
  speed      Decimal? @db.Decimal(6, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([jobId, recordedAt])
  @@map("job_location_logs")
}

// ─── Money ───────────────────────────────────────────────────────────────────

model Wallet {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  heldBalance Decimal  @default(0) @map("held_balance") @db.Decimal(12, 2)
  currency    String   @default("GBP")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String                @map("wallet_id")
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(12, 2)
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id")
  description   String?
  createdAt     DateTime              @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model Payment {
  id                    String        @id @default(uuid())
  jobId                 String        @unique @map("job_id")
  method                PaymentMethod
  amount                Decimal       @db.Decimal(12, 2)
  status                PaymentStatus @default(pending)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  stripePaymentMethodId String?       @map("stripe_payment_method_id")
  paidAt                DateTime?     @map("paid_at")
  refundedAt            DateTime?     @map("refunded_at")
  refundAmount          Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id])
  invoice Invoice?

  @@map("payments")
}

model ProviderEarning {
  id           String       @id @default(uuid())
  jobId        String       @unique @map("job_id")
  providerId   String       @map("provider_id")
  grossAmount  Decimal      @map("gross_amount") @db.Decimal(12, 2)
  platformFee  Decimal      @map("platform_fee") @db.Decimal(12, 2)
  netAmount    Decimal      @map("net_amount") @db.Decimal(12, 2)
  payoutStatus PayoutStatus @default(pending) @map("payout_status")
  payoutId     String?      @map("payout_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  job      Job      @relation(fields: [jobId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])
  payout   Payout?  @relation(fields: [payoutId], references: [id])

  @@index([providerId])
  @@map("provider_earnings")
}

model Payout {
  id             String       @id @default(uuid())
  providerId     String       @map("provider_id")
  amount         Decimal      @db.Decimal(12, 2)
  status         PayoutStatus @default(pending)
  bankAccountId  String?      @map("bank_account_id")
  bankAccountRef String?      @map("bank_account_ref")
  stripeTransferId String?    @map("stripe_transfer_id")
  processedAt    DateTime?    @map("processed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  provider    Provider          @relation(fields: [providerId], references: [id])
  bankAccount BankAccount?      @relation(fields: [bankAccountId], references: [id])
  earnings    ProviderEarning[]

  @@index([providerId])
  @@map("payouts")
}

model BankAccount {
  id            String   @id @default(uuid())
  providerId    String   @map("provider_id")
  bankName      String   @map("bank_name")
  accountHolder String   @map("account_holder")
  accountNumber String   @map("account_number")
  routingNumber String?  @map("routing_number")
  lastFour      String   @map("last_four")
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  payouts  Payout[]

  @@index([providerId])
  @@map("bank_accounts")
}

// ─── Ratings & Support ───────────────────────────────────────────────────────

model Rating {
  id         String   @id @default(uuid())
  jobId      String   @map("job_id")
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  score      Int
  comment    String?
  isHidden   Boolean  @default(false) @map("is_hidden")
  createdAt  DateTime @default(now()) @map("created_at")

  job      Job  @relation(fields: [jobId], references: [id])
  fromUser User @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUser   User @relation("RatingsReceived", fields: [toUserId], references: [id])

  @@unique([jobId, fromUserId])
  @@map("ratings")
}

model SupportTicket {
  id           String              @id @default(uuid())
  ticketNumber String              @unique @map("ticket_number")
  userId       String              @map("user_id")
  jobId        String?             @map("job_id")
  category     String
  subject      String
  status       SupportTicketStatus @default(open)
  priority     SupportPriority     @default(medium)
  assignedToId String?             @map("assigned_to_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  resolvedAt   DateTime?           @map("resolved_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id])
  job        Job?             @relation(fields: [jobId], references: [id])
  assignedTo AdminUser?       @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages   SupportMessage[]

  @@index([status, createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id            String   @id @default(uuid())
  ticketId      String   @map("ticket_id")
  senderId      String   @map("sender_id")
  senderType    String   @map("sender_type")
  message       String
  attachmentUrl String?  @map("attachment_url")
  createdAt     DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
  @@map("support_messages")
}

// ─── Notifications & CMS ─────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id            String              @id @default(uuid())
  slug          String              @unique
  channel       NotificationChannel
  titleTemplate String              @map("title_template")
  bodyTemplate  String              @map("body_template")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model AdminBroadcast {
  id        String   @id @default(uuid())
  title     String
  body      String
  audience  String
  sentCount Int      @default(0) @map("sent_count")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_broadcasts")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model CmsBanner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String   @map("image_url")
  link      String?
  targetApp String   @default("customer") @map("target_app")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cms_banners")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model LegalDocument {
  key       String   @id
  title     String
  content   String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("legal_documents")
}

model Country {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique @db.VarChar(2)
  code3     String   @db.VarChar(3)
  numeric   String   @db.VarChar(3)
  dialCode  String   @map("dial_code")
  icon      String
  isActive  Boolean  @default(false) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("countries")
}

model ServiceZone {
  id        String       @id @default(uuid())
  name      String
  audience  ZoneAudience @default(both)
  centerLat Decimal      @map("center_lat") @db.Decimal(10, 7)
  centerLng Decimal      @map("center_lng") @db.Decimal(10, 7)
  radiusKm  Decimal      @map("radius_km") @db.Decimal(6, 2)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("service_zones")
}

model CoverageInterest {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  audience     ZoneAudience
  lat          Decimal      @db.Decimal(10, 7)
  lng          Decimal      @db.Decimal(10, 7)
  addressLabel String?      @map("address_label")
  notifiedAt   DateTime?    @map("notified_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("coverage_interests")
}

model TrainingProgram {
  id                String   @id @default(uuid())
  title             String
  serviceCategoryId String?  @unique @map("service_category_id")
  passPercent       Int      @default(80) @map("pass_percent")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  blocks          TrainingBlock[]
  questions       TrainingQuestion[]
  attempts        ProviderTrainingAttempt[]

  @@map("training_programs")
}

model TrainingBlock {
  id        String            @id @default(uuid())
  programId String            @map("program_id")
  sortOrder Int               @default(0) @map("sort_order")
  type      TrainingBlockType
  body      String
  caption   String?

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, sortOrder])
  @@map("training_blocks")
}

model TrainingQuestion {
  id        String @id @default(uuid())
  programId String @map("program_id")
  sortOrder Int    @default(0) @map("sort_order")
  prompt    String

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  options TrainingOption[]

  @@index([programId, sortOrder])
  @@map("training_questions")
}

model TrainingOption {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  label      String
  isCorrect  Boolean @default(false) @map("is_correct")

  question TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("training_options")
}

model ProviderTrainingAttempt {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  programId  String   @map("program_id")
  score      Int
  passed     Boolean
  createdAt  DateTime @default(now()) @map("created_at")

  provider Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  program  TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([providerId, programId])
  @@map("provider_training_attempts")
}

model ProviderQualification {
  id                String              @id @default(uuid())
  providerId        String              @map("provider_id")
  serviceCategoryId String              @map("service_category_id")
  status            QualificationStatus @default(not_started)
  updatedAt         DateTime            @updatedAt @map("updated_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  provider        Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceCategoryId])
  @@map("provider_qualifications")
}

model EquipmentRequirement {
  id                String   @id @default(uuid())
  serviceCategoryId String   @map("service_category_id")
  label             String
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")

  serviceCategory ServiceCategory    @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)
  documents       ProviderDocument[]

  @@index([serviceCategoryId])
  @@map("equipment_requirements")
}

model AgreementDocument {
  id                  String       @id @default(uuid())
  key                 AgreementKey
  version             String
  title               String
  body                String
  acknowledgements    String[]     @default([])
  isRequiredForOnline Boolean      @default(true) @map("is_required_for_online")
  isCurrent           Boolean      @default(true) @map("is_current")
  createdAt           DateTime     @default(now()) @map("created_at")

  @@unique([key, version])
  @@map("agreement_documents")
}

model ProviderAgreementAcceptance {
  id           String       @id @default(uuid())
  providerId   String       @map("provider_id")
  agreementKey AgreementKey @map("agreement_key")
  version      String
  acceptedAt   DateTime     @default(now()) @map("accepted_at")
  appVersion   String?      @map("app_version")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, agreementKey])
  @@map("provider_agreement_acceptances")
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique @map("invoice_number")
  jobId         String    @unique @map("job_id")
  paymentId     String?   @unique @map("payment_id")
  customerId    String    @map("customer_id")
  email         String?
  total         Decimal   @db.Decimal(12, 2)
  issuedAt      DateTime  @default(now()) @map("issued_at")
  sentAt        DateTime? @map("sent_at")

  job      Job      @relation(fields: [jobId], references: [id])
  payment  Payment? @relation(fields: [paymentId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("invoices")
}

model DriverSubscriptionPlan {
  id             String             @id @default(uuid())
  name           String
  period         SubscriptionPeriod
  price          Decimal            @db.Decimal(10, 2)
  commissionRate Decimal            @default(0) @map("commission_rate") @db.Decimal(5, 4)
  isActive       Boolean            @default(true) @map("is_active")
  sortOrder      Int                @default(0) @map("sort_order")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  subscriptions DriverSubscription[]

  @@map("driver_subscription_plans")
}

model DriverSubscription {
  id                      String                   @id @default(uuid())
  providerId              String                   @map("provider_id")
  planId                  String                   @map("plan_id")
  status                  DriverSubscriptionStatus @default(pending)
  startsAt                DateTime?                @map("starts_at")
  expiresAt               DateTime?                @map("expires_at")
  stripePaymentIntentId   String?                  @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?                  @map("stripe_checkout_session_id")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  provider Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  plan     DriverSubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([providerId, status])
  @@index([expiresAt])
  @@map("driver_subscriptions")
}

model WhatsAppSession {
  id            String   @id @default(uuid())
  phone         String   @unique
  customerId    String?  @map("customer_id")
  state         String   @default("idle")
  draft         Json     @default("{}")
  lastJobId     String?  @map("last_job_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_sessions")
}
