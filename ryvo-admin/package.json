{
  "name": "ryvo-admin",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "npm run generate --workspace=@ryvo/database",
    "db:migrate": "npm run migrate --workspace=@ryvo/database",
    "db:seed": "npm run seed --workspace=@ryvo/database",
    "db:seed:countries": "npm run seed:countries --workspace=@ryvo/database",
    "db:push": "npm run push --workspace=@ryvo/database"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
